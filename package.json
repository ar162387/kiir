{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "cms:db": "node --env-file=.env --env-file-if-exists=.env.local scripts/cms-db.mjs",
    "cms:create-admin": "node --env-file=.env --env-file-if-exists=.env.local scripts/create-admin.mjs",
    "test:cms:integration": "node --env-file=.env --env-file-if-exists=.env.local scripts/test-cms-auth.mjs",
    "cms:setup-media": "node --env-file=.env --env-file-if-exists=.env.local scripts/setup-media.mjs",
    "test:programs:integration": "node --env-file=.env --env-file-if-exists=.env.local scripts/test-programs.mjs",
    "cms:record-migration": "node --env-file=.env --env-file-if-exists=.env.local scripts/record-migration.mjs",
    "test:content:integration": "node --env-file=.env --env-file-if-exists=.env.local scripts/test-content.mjs",
    "test:settings:integration": "node --env-file=.env --env-file-if-exists=.env.local scripts/test-settings.mjs",
    "cms:backup": "node --env-file=.env --env-file-if-exists=.env.local scripts/backup-cms.mjs",
    "cms:health": "node --env-file=.env --env-file-if-exists=.env.local scripts/cms-health.mjs",
    "check:release": "node --env-file=.env --env-file-if-exists=.env.local scripts/check-release.mjs"
