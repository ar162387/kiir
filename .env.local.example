# Staff Auth accepts these canonical names, or SUPABASE_PROJECT_URL /
# SUPABASE_PUBLISHABLE_KEY from the existing .env. Never use a secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical public origin used by metadata, sitemap and feeds.
NEXT_PUBLIC_SITE_URL=https://kiir-opal.vercel.app

# Server only: staff provisioning, password resets and durable login rate limits.
SUPABASE_SECRET_KEY=

# Maintenance only. Use the session pooler on networks without IPv6.
SUPABASE_DB_POOLER_URL=postgresql://postgres.PROJECT_REF@YOUR_SESSION_POOLER:5432/postgres
SUPABASE_DATABASE_PASSWORD=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
